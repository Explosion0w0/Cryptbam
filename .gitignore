# private keys: never commit (generate with scripts/keygen.sh or `python -m cryptbam keygen`)
*.sec
**/keys/

# outputs (regenerated by the demos)
**/out/

# simulated data: regenerated by cryptbam/scripts/simulate.py (keep policy + BEDs)
cryptbam/data/*
!cryptbam/data/policy.json
!cryptbam/data/beds/

# real-data demo inputs: downloaded by cryptbam/scripts/fetch_demo_data.sh
cryptbam/demo/data/
# IGV batch files hold machine-specific paths (scripts/igv_prep.sh writes them)
cryptbam/demo/igv/*.batch

# misc
cryptbam.zip
__pycache__/
*.pyc
.swp
*.swp
.claude/
